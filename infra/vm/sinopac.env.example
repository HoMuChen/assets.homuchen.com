# /opt/assets/sinopac.env (owner deploy, chmod 600) — read only by the sinopac sidecar container.
# Use a dedicated SinoPac API key with 行情/資料 + 帳務 + 正式環境 and WITHOUT 交易, IP-limited to this VM.
# Left empty, the sidecar still runs and the app reports "未設定" for SinoPac-synced accounts.
SJ_API_KEY=
SJ_SEC_KEY=
