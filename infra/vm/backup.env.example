# /opt/assets/backup.env (owner deploy, chmod 600) — read only by backup.sh, never by the container.
# Same R2 token and bucket as HQ's backups (HQ prunes only db/, this backup only assets/).
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=hq-backup
# Optional healthchecks.io ping URL
BACKUP_PING_URL=
