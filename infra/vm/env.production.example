# /opt/assets/.env (owner deploy, chmod 600) — passed to the container. DATA_DIR, PORT and TZ are set by the image.

# FinMind sponsor token (real-time taiwan_stock_tick_snapshot)
FINMIND_TOKEN=
# Optional CoinGecko demo API key
COINGECKO_API_KEY=
# Login password. Required in production; leaving it empty disables login entirely.
APP_PASSWORD=
COOKIE_SECURE=true

# Telegram alerts and nightly digest: create a bot with @BotFather, add it to your chat (or family group),
# send it a message, then read chat.id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Nightly digest after the 23:55 snapshot: pct (default, percentages only) | full (with amounts) | off
TELEGRAM_DIGEST=pct
# 風險指標 alert thresholds for SinoPac-synced futures accounts, in % (defaults 150 / 100)
ALERT_TW_RISK_WARN=150
ALERT_TW_RISK_URGENT=100
# Bybit sync (Unified Trading Account). Create a Read-Only key with only Contract, Spot and Wallet read
# permissions, bound to this VM's IP. Bybit refuses US and mainland China IPs (403). Leave empty to keep manual.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Liquidation alerts for Bybit, in %: distance from mark to liquidation price (defaults 15 / 7) and the
# account's maintenance margin rate (defaults 50 / 75; Bybit liquidates at 100)
ALERT_LIQ_WARN=15
ALERT_LIQ_URGENT=7
ALERT_MMR_WARN=50
ALERT_MMR_URGENT=75
# Shared with backup.env: backup.sh and restore-check.sh report to /api/heartbeat with it. openssl rand -hex 32
HEARTBEAT_TOKEN=
