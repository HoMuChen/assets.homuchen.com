# FinMind API token (sponsor tier enables real-time taiwan_stock_tick_snapshot)
FINMIND_TOKEN=

# Optional CoinGecko demo API key (higher rate limits)
COINGECKO_API_KEY=

# Login password. Leave empty to disable auth (only for LAN / localhost use).
APP_PASSWORD=

# Set to "false" if serving over plain HTTP (no TLS) so the session cookie still works.
COOKIE_SECURE=true

# Where the SQLite database lives (default ./data)
# DATA_DIR=/data

# Optional: Telegram alerts and nightly digest (see infra/vm/env.production.example)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_DIGEST=pct
